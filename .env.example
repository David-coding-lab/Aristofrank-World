# Public origin of this app (no trailing slash), e.g. http://localhost:3000.
# Used for OAuth redirect URLs, metadataBase, and canonical links.
# Set per deployment to that deployment's own origin.
NEXT_PUBLIC_SITE_URL=

# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_VERIFY_REDIRECT_URL=
NEXT_PUBLIC_APPWRITE_RESET_REDIRECT_URL=

# Server-only secrets — never expose to the client (no NEXT_PUBLIC_ prefix).
# Auth key: Appwrite API key with ONLY Auth scopes (sessions.write, users.write,
# users.read). Used for registration and creating login sessions.
APPWRITE_API_KEY=

# Database key: Appwrite API key with ONLY Databases scopes (databases.read,
# databases.write / tables + rows read & write). Used for server-side writes to
# tables clients can't write to.
APPWRITE_DB_API_KEY=
