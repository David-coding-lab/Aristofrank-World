# Public origin of this app (no trailing slash), e.g. https://aristofrank.world.
# Used for OAuth redirects, email links, metadataBase, and canonical links.
NEXT_PUBLIC_SITE_URL=

# Prisma / PostgreSQL. DATABASE_URL is the runtime connection (a transaction
# pooler is fine). DIRECT_URL is used for migrations and must be a direct or
# session-mode connection. In production require TLS (for example
# ?sslmode=require, or verify-full with a provider CA).
DATABASE_URL=
DIRECT_URL=

# Email delivery (Resend). Required in production for sign-up verification
# and password reset. In development the link is printed to the server console
# when these are empty.
RESEND_API_KEY=
EMAIL_FROM="Aristofrank World <no-reply@your-domain.com>"

# Google OAuth. Authorized redirect URI:
#   ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI overrides the derived callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Set to "true" only when the origin is reachable exclusively through
# Cloudflare, so CF-Connecting-IP cannot be spoofed by a direct client.
TRUST_CF_CONNECTING_IP=false
