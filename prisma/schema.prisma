generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessions            Session[]
  oauthAccounts       OAuthAccount[]
  tokens              VerificationToken[]

  @@index([emailVerified])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Client testimonials. `comment` replaces `quote`; `company` replaces `role`.
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  comment   String   @db.Text
  rating    Int      @default(5)
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rating])
  @@index([createdAt])
}

/// Represented talent. `genre` is stored as a JSON array of strings.
/// `profileUrl` and `profileImage` replace `slug`/`imageUrl`.
model Artist {
  id          String   @id @default(cuid())
  name        String
  genre       Json
  profileUrl  String   @unique
  profileImage String
  bio         String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

/// Music tracks. `coverImage` replaces `coverUrl`; `artistProfileUrl`
/// links to the artist's public profile page.
model Music {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  audioUrl       String
  coverImage     String
  artistProfileUrl String
  duration       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([title])
  @@index([createdAt])
}

/// Video content with thumbnail and direct video URL.
model Video {
  id            String   @id @default(cuid())
  title         String
  thumbnailImage String
  videoUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([title])
  @@index([createdAt])
}

/// Media / press coverage entries.
model Media {
  id            String   @id @default(cuid())
  title         String
  thumbnailImage String
  sourceUrl     String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

/// Public events with ticketing info.
model Event {
  id             String   @id @default(cuid())
  title          String
  date           DateTime
  description    String   @db.Text
  location       String
  ticketPrice    Int
  availableTickets Int
  coverImage     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([title])
}

enum ContactInquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

/// Inbound project and service inquiries submitted from /contact-us.
model ContactInquiry {
  id        String                @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String                @db.Text
  status    ContactInquiryStatus  @default(NEW)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// Persistent, database-backed auth throttles. Keys are SHA-256 hashes so this
/// table never stores raw email addresses or IP addresses.
model AuthThrottle {
  id            String    @id @default(cuid())
  scope         String
  keyHash       String
  attempts      Int       @default(0)
  windowStart   DateTime  @default(now()) @db.Timestamptz(3)
  lockedUntil   DateTime? @db.Timestamptz(3)
  lastAttemptAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([scope, keyHash])
  @@index([lastAttemptAt])
  @@index([lockedUntil])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
